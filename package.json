{
  "name": "ai-ulu-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ai-ulu.com — fast, secure websites for businesses and individuals.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @ai-ulu/sablonlar && node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "lint": "oxlint && stylelint \"src/site/assets/*.css\"",
    "check": "node scripts/check.mjs",
    "ping": "node scripts/indexnow.mjs",
    "report": "node scripts/report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "html-validate": "^11.21.0",
    "jsdom": "^31.0.0",
    "ogl": "^1.0.11",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "wrangler": "4.158.0"
  },
  "workspaces": [
    "apps/sablonlar"
  ]
}
