Options -Indexes

# Markalı 404 (dist/404.html)
ErrorDocument 404 /404.html

# The hosting account has a Git deploy that mirrors the repository into this
# directory on every push to main. The build output is what belongs here, so
# refuse the repository's own paths even if the mirror recreates them.
RedirectMatch 404 ^/shipcraft(/|$)
RedirectMatch 404 ^/(\.git|\.github)(/|$)

# Markdown and JSON are served on purpose: every page has a .md alternate and
# /.well-known/mcp/server-card.json must be readable. Only source artefacts stay blocked.
AddType text/markdown .md
AddCharset UTF-8 .md
AddType application/json .json

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Content negotiation: an agent that asks for markdown gets the .md alternate of
  # the same URL instead of the HTML. The last condition means the rewrite only
  # fires when that .md file actually exists, so nothing 404s. Browsers never send
  # this Accept value, so normal visitors are unaffected.
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_URI} !\.(md|txt|xml|json|svg|css|js|webp|png|woff2|ico)$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.md -f
  RewriteRule ^(.*?)/?$ /$1/index.md [L]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/$" IS_HOME_EN
  SetEnvIf Request_URI "^/tr/$" IS_HOME_TR
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: once seen, browsers refuse plain HTTP for max-age. Kept short (1 day) so a
  # certificate lapse is recoverable within a day. Raise to 31536000 once stable.
  # No includeSubDomains/preload: neither is safe to promise before they are proven.
  Header always set Strict-Transport-Security "max-age=86400"
  # RFC 8288 Link header: llms.txt is a site-wide resource, so it is advertised on
  # every page. The homepage additionally points at its markdown alternate.
  Header set Link "<https://ai-ulu.com/llms.txt>; rel=\"llms-txt\"; type=\"text/plain\""
  Header add Link "<https://ai-ulu.com/index.md>; rel=\"alternate\"; type=\"text/markdown\"" env=IS_HOME_EN
  Header add Link "<https://ai-ulu.com/tr/index.md>; rel=\"alternate\"; type=\"text/markdown\"" env=IS_HOME_TR
  # The body depends on Accept, so caches must key on it.
  Header append Vary Accept

  # The Server Card has its own registered media type.
  <Files "server-card.json">
    Header set Content-Type "application/mcp-server-card+json"
  </Files>
</IfModule>

# Never serve dotfiles
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never serve source or config artefacts
<FilesMatch "\.(mjs|ya?ml|lock|log|sh|bak|ini|sql|env|toml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/markdown application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/markdown "access plus 1 hour"
</IfModule>

